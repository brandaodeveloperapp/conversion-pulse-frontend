# Dashboard vhost. The Next app runs in k3s on NodePort 30984, reachable only
# from the host; nginx is the single public door. TLS lines managed by Certbot.

server {
    server_name conversion-pulse-app.brandaodeveloper.com.br;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    server_tokens off;

    location / {
        proxy_pass http://127.0.0.1:30984;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        client_max_body_size 2m;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    listen 80;
    listen [::]:80;
}
